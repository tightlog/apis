{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tightlog-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "upload_source_maps": true,
  "env": {
    "staging": {
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "vars": {
        "SENTRY_ENVIRONMENT": "staging",
        "SENTRY_TRACES_SAMPLE_RATE": "1.0"
      }
    },
    "production": {
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "vars": {
        "SENTRY_ENVIRONMENT": "production",
        "SENTRY_TRACES_SAMPLE_RATE": "1.0"
      }
    }
  }
}
